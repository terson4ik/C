#include <stdio.h>
#include "m_sort.h"
#include "mstring.h"

struct key *binsearch(char *word, struct key *tab, int lim)
{
    int cond;
    struct key *left = &tab[0];
    struct key *right = &tab[lim] - 1;
    struct key *mid;
    while (left <= right) {
        mid = left + (right - left) / 2;
        cond = mstrcmp(word, mid->word);
        if (cond > 0)
            left = mid + 1;
        else if (cond < 0)
            right = mid - 1;
        else /* cond == 0 */
            return mid;
    }
    return NULL;
}
